{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/decisions.md", "PROGRESS.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "falkordb": {
      "type": "local",
      "command": ["npx", "-y", "@falkordb/mcpserver@latest"],
      "enabled": true,
      "environment": {
        "FALKORDB_HOST": "{env:FALKORDB_HOST}",
        "FALKORDB_PORT": "{env:FALKORDB_PORT}"
      }
    },
    "tavily": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp@latest"],
      "enabled": true,
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      }
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "docker *": "allow",
      "graphify *": "allow",
      "ls *": "allow",
      "cat .env*": "deny",
      "cat **/.env*": "deny",
      "rm -rf *": "ask"
    }
  }
}
