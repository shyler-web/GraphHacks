# dependencies
node_modules/

# python backend (uv) — never commit the venv; keep uv.lock
backend/.venv/
__pycache__/
*.pyc

# build output
dist/
dist-ssr/
*.local
*.tsbuildinfo

# env + secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# graphify outputs — keep ONLY the load-bearing graph.json (Track 01/03 + Docker).
# Everything else (html viz, reports, manifests, snapshots, cache) is regenerable.
graphify-out/*
!graphify-out/graph.json

# personal teaching/reference material — local only, not part of the submission
lessons/
assets/diagrams/

# local db / containers
*.rdb
/data/
!src/data/

# SDD workspace (git-ignored scratch)
.superpowers/
