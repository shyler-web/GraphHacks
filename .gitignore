# dependencies
node_modules/

# python backend (uv) — never commit the venv; keep uv.lock
backend/.venv/
__pycache__/
*.pyc

# build output
dist/
dist-ssr/
*.local
*.tsbuildinfo

# env + secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# graphify cache (regenerated; keep graph.json + reports)
graphify-out/cache/
graphify-out/.graphify_*

# local db / containers
*.rdb
/data/
!src/data/

# SDD workspace (git-ignored scratch)
.superpowers/
