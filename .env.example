# Copy to .env and fill in. NEVER commit .env itself.

# --- FalkorDB (the load-bearing graph database) ---
# Host-run dev: localhost. Inside docker compose the backend sets
# FALKORDB_HOST=falkordb / FALKORDB_PORT=6379 automatically (see docker-compose.yml).
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# --- Cockpit dev proxy (F1) ---
# Where Vite forwards /api/* in `npm run dev`. Default http://localhost:8000;
# unused by the compose build (nginx proxies to http://backend:8000 instead).
VITE_PROXY_TARGET=http://localhost:8000

# --- LLM (Nebius Token Factory — OpenAI-compatible) ---
# Nebius replaces Gemini as the LLM provider. Put your key here (never commit .env).
NEBIUS_API_KEY=
# Optional overrides (defaults shown):
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct   # or an NVIDIA/NIM id, e.g. nvidia/llama-3.3-70b-instruct

# --- Tools (web-search grounding, replaces Gemini google_search) ---
TAVILY_API_KEY=

# --- Observability (LangSmith tracing) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graphhacks-track02
