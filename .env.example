# Copy to .env and fill in. NEVER commit .env itself.

# --- FalkorDB (the load-bearing graph database) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# --- LLM (used by the agent backend for extraction + reasoning) ---
GEMINI_API_KEY=

# --- Tools ---
TAVILY_API_KEY=

# --- Observability (LangSmith tracing) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=graphhacks-track02
