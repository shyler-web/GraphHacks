# Keep the frontend image build context small and secret-free.
# Never ship secrets into an image.
.env
.env.*
!.env.example

# Dependencies / build output (rebuilt inside the image)
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Python backend (built from ./backend in its own context)
backend/.venv/
**/__pycache__/
*.pyc

# Self-reference
Dockerfile
.dockerignore

# Local artifacts not needed for the frontend build
.git/
.gitignore
dump/
.superpowers/
graphify-out/cache/
*.rdb
/data/
